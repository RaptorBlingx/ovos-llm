{% if models is defined and models|length > 0 %}
Found {{ models|length }} baseline models for {{ seu_name }}. Active model: version {{ active_version }}, R-squared {{ active_r_squared }}, trained on {{ active_samples }} samples.
{% elif is_configured_seu is defined and not is_configured_seu %}
{{ seu_name }} does not have a configured {{ energy_source|replace('_', ' ') }} baseline model.
{% else %}
No baseline models found for {{ seu_name }}.
{% endif %}

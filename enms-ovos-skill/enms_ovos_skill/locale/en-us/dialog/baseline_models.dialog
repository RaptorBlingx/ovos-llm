{% if all_machines is defined and all_machines %}
{# List all machines with baseline models #}
{% if models|length > 0 %}Found {{ models|length }} machine{{ 's' if models|length > 1 else '' }} with trained baseline models: {% for model in models %}{{ model.seu_name }} (version {{ model.model_version }}, {{ (model.r_squared * 100)|round(1) }}% accuracy){% if not loop.last %}, {% endif %}{% endfor %}.{% else %}No machines have trained baseline models yet.{% endif %}
{% elif models is defined and models|length > 0 %}
